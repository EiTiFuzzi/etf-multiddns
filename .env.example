# Copy this file to ".env" and fill in your values.
# Alternatively, everything can also be configured conveniently in the Web UI
# (Settings) - in that case this file can stay empty / be ignored.

# Personal Access Token: https://domain.chief.app/api/token/create
# Required scopes: domainchief:dns:read, domainchief:dns:write, domainchief:domains:read
DOMAINCHIEF_API_TOKEN=

# Only needed if you do NOT use a Team Access Token and don't want your
# account's default team to be used.
DOMAINCHIEF_TEAM_ID=

# How often (in seconds) the public IP is checked. Minimum 60.
CHECK_INTERVAL=300

LOG_LEVEL=INFO

# Timezone (optional, IANA name e.g. "Europe/Vienna"), affects the logs and
# the timestamps shown in the Web UI. Empty/unset = UTC. If set here, it
# takes precedence and the "Timezone" field in Settings is disabled.
# Alternatively selectable conveniently in the Web UI under Settings - along
# with the display date/time format.
TZ=

# Web UI credentials (optional). If NOT set, the Web UI automatically asks
# for a username/password on first launch (setup wizard) and stores them (as
# a hash) in the configuration file. If set here, the environment variables
# take precedence and can't be changed in the Web UI.
WEBUI_USERNAME=
WEBUI_PASSWORD=
